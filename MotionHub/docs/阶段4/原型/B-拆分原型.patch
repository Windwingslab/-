index 0000000..72520b2
--- /dev/null
+++ b/MotionHub/tests/versioncheck.js
@@ -0,0 +1,44 @@
+// 版本号检查：每个扩展包里写版本号的地方全部一致；同一个扩展 ID 只能出现在一个包里
+// 发布前：node versioncheck.js --release studio   这个包自上次发布（标签 studio-vX.Y.Z）以来有改动，版本号就必须变大
+"use strict";
+const fs = require("fs"), path = require("path"), cp = require("child_process");
+const R = path.join(__dirname, "..");
+const BUNDLES = {
+    motionhub: { dir: "com.windwings.motionhub", page: "index.html", host: "jsx/host.jsx" },
+    studio: { dir: "com.windwings.studio", page: "studio.html", host: "jsx/studio.jsx" }
+};
+const STUDIO_ID = "com.windwings.motionhub.studio";
+let bad = 0;
+const fail = m => { bad++; console.log("✗ " + m); };
+const owners = {}, vers = {};
+for (const name of Object.keys(BUNDLES)) {
+    const b = BUNDLES[name], d = path.join(R, b.dir);
+    const man = fs.readFileSync(path.join(d, "CSXS/manifest.xml"), "utf8"), page = fs.readFileSync(path.join(d, b.page), "utf8");
+    const ver = vers[name] = /ExtensionBundleVersion="([^"]+)"/.exec(man)[1];
+    const found = [];
+    (man.match(/<Extension Id="[^"]+" Version="[^"]+"/g) || []).forEach(s => found.push(["manifest " + /Id="([^"]+)"/.exec(s)[1], /Version="([^"]+)"/.exec(s)[1]]));
+    (page.match(/\?v=[^"']+/g) || []).forEach(s => found.push([b.page + " " + s, s.slice(3)]));
+    found.push([b.page + " data-mh-version", (/data-mh-version="([^"]+)"/.exec(page) || [])[1]]);
+    (page.match(/· v\d+\.\d+\.\d+/g) || []).forEach(s => found.push([b.page + " 版本标签", s.slice(3)]));
+    found.push([b.host + " VERSION", (/var VERSION = "([^"]+)"/.exec(fs.readFileSync(path.join(d, b.host), "utf8")) || [])[1]]);
+    found.filter(f => f[1] !== ver).forEach(f => fail(name + "：" + f[0] + " 是 " + f[1] + "，manifest 是 " + ver));
+    new Set((man.match(/<Extension Id="([^"]+)"/g) || []).map(s => s.slice(15, -1))).forEach(id => (owners[id] = owners[id] || []).push(name));
+}
+Object.keys(owners).filter(id => owners[id].length > 1).forEach(id => fail("扩展 ID " + id + " 同时出现在 " + owners[id].join(" 和 ") + "：AE 里会冲突"));
+if (JSON.stringify(owners[STUDIO_ID]) !== '["studio"]') fail(STUDIO_ID + " 必须只由 Studio 包声明，现在是 " + JSON.stringify(owners[STUDIO_ID]));
+const ri = process.argv.indexOf("--release");
+if (ri > 0) {
+    const name = process.argv[ri + 1], b = BUNDLES[name], ver = vers[name];
+    const num = v => v.split(".").map(Number), cmp = (a, c) => { for (let i = 0; i < 3; i++) if (num(a)[i] !== num(c)[i]) return num(a)[i] - num(c)[i]; return 0; };
+    const tags = cp.execFileSync("git", ["tag", "--list", name + "-v*"], { cwd: R, encoding: "utf8" }).split("\n").filter(Boolean).map(t => t.slice(name.length + 2)).sort(cmp);
+    const last = tags[tags.length - 1];
+    if (last) {
+        let changed = false;
+        try { cp.execFileSync("git", ["diff", "--quiet", name + "-v" + last, "--", b.dir], { cwd: R }); } catch (e) { changed = true; }
+        if (cmp(ver, last) < 0) fail(name + "：版本 " + ver + " 比上次发布的 " + last + " 还小");
+        else if (cmp(ver, last) === 0 && changed) fail(name + "：" + b.dir + " 自 " + last + " 以来有改动，版本号还是 " + last + "：先改版本号");
+    }
+    if (!bad) console.log("✓ 可以发布 " + name + " " + ver + (last ? "（上次 " + last + "）" : "（第一次发布）"));
+}
+console.log(bad ? "✗ 版本检查：" + bad + " 项没通过" : "✓ 版本检查通过：面板包 " + vers.motionhub + " · Studio 包 " + vers.studio);
+process.exit(bad ? 1 : 0);
