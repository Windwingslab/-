+case "$IDS" in *motionhub*) echo "  面板：窗口 → 扩展 → MotionHub（以及 2 / 3 / 4）";; esac
+case "$IDS" in *studio*) echo "  Studio：窗口 → 扩展 → MotionHub Studio · 剪辑排版，左上角显示 v$(ver "$DEST/com.windwings.studio") 就说明装的是新版";; esac
 echo ""
 read -n 1 -s -r -p "按任意键关闭…"
diff --git "a/MotionHub/\345\256\211\350\243\205-Windows.bat" "b/MotionHub/\345\256\211\350\243\205-Windows.bat"
index 8930cba..571b4ff 100644
--- "a/MotionHub/\345\256\211\350\243\205-Windows.bat"
+++ "b/MotionHub/\345\256\211\350\243\205-Windows.bat"
@@ -1,40 +1,78 @@
-@echo off
-chcp 65001 >nul
-rem MotionHub 一键安装（Windows）
-set "ID=com.windwings.motionhub"
-set "SRC=%~dp0%ID%"
-set "DEST=%APPDATA%\Adobe\CEP\extensions\%ID%"
-
-echo == MotionHub 安装 ==
-if not exist "%SRC%" (
-    echo 找不到 %ID% 文件夹，请把本文件和它放在同一个目录里再运行。
-    pause
-    exit /b 1
-)
-
-tasklist /FI "IMAGENAME eq AfterFX.exe" 2>nul | find /I "AfterFX.exe" >nul
-if not errorlevel 1 (
-    echo 注意：After Effects 正在运行。请先完全关闭 AE，然后按任意键继续安装。
-    pause >nul
-)
-
-if exist "%DEST%" rmdir /s /q "%DEST%"
-xcopy "%SRC%" "%DEST%\" /E /I /Y /Q >nul
-
-rem 清掉扩展缓存，避免继续用旧的界面和脚本
-for /d %%d in ("%TEMP%\cep_cache\*motionhub*") do rmdir /s /q "%%d" 2>nul
-for /d %%d in ("%LOCALAPPDATA%\Temp\cep_cache\*motionhub*") do rmdir /s /q "%%d" 2>nul
-if exist "%ProgramFiles(x86)%\Common Files\Adobe\CEP\extensions\%ID%" echo 注意：系统目录里还有一份旧版，请手动删除：%ProgramFiles(x86)%\Common Files\Adobe\CEP\extensions\%ID%
-
-rem 允许加载未签名扩展（AE 2020 及以上对应 CSXS 9-13）
-for %%v in (9 10 11 12 13) do reg add "HKCU\Software\Adobe\CSXS.%%v" /v PlayerDebugMode /t REG_SZ /d 1 /f >nul
-
-echo.
-echo 已安装到：%DEST%
-echo 已开启扩展加载权限
-echo 已清除扩展缓存
-echo.
-echo 下一步：完全关闭 After Effects 后重新打开，
-echo 在菜单「窗口 - 扩展 - MotionHub」打开面板。
-echo.
-pause
+@echo off
+chcp 65001 >nul
+setlocal EnableDelayedExpansion
+rem MotionHub 一键安装（Windows）：装本文件旁边的扩展包，有哪个装哪个
+rem   com.windwings.motionhub  面板（窗口 - 扩展 - MotionHub / 2 / 3 / 4）
+rem   com.windwings.studio     Studio（窗口 - 扩展 - MotionHub Studio · 剪辑排版）
+set "HERE=%~dp0"
+set "ROOT=%APPDATA%\Adobe\CEP\extensions"
+set "SYSROOT=%ProgramFiles(x86)%\Common Files\Adobe\CEP\extensions"
+rem 3.7 及以前 Studio 的扩展声明在面板包里；用正则避开引号
+set "OLDSTUDIO=Extension Id=.com\.windwings\.motionhub\.studio."
+
+echo == MotionHub 安装 ==
+set "IDS="
+for %%i in (com.windwings.motionhub com.windwings.studio) do if exist "%HERE%%%i\CSXS\manifest.xml" set "IDS=!IDS! %%i"
+if "%IDS%"=="" (
+    echo 找不到要安装的文件夹：把本文件和 com.windwings.motionhub / com.windwings.studio 放在同一个目录里再运行。
+    pause
+    exit /b 1
+)
+
+rem 只装 Studio，但已装的面板包是 3.7 及以前（自带旧 Studio）：两个包会声明同一个扩展 ID
+if not exist "%HERE%com.windwings.motionhub" (
+    for %%m in ("%ROOT%\com.windwings.motionhub" "%SYSROOT%\com.windwings.motionhub") do (
+        findstr /r /c:"%OLDSTUDIO%" "%%~m\CSXS\manifest.xml" >nul 2>&1 && (
+            echo 先升级 MotionHub：已装的 MotionHub 自带旧版 Studio，和单独安装的 Studio 冲突，这次没有安装。
+            echo 运行 MotionHub 3.8 及以上安装包里的「安装-Windows.bat」，它会把面板和 Studio 一起装好。
+            pause
+            exit /b 1
+        )
+    )
+)
+rem 只装面板，旧面板包自带的 Studio 会跟着消失：先说清楚
+if not exist "%HERE%com.windwings.studio" if not exist "%ROOT%\com.windwings.studio" (
+    findstr /r /c:"%OLDSTUDIO%" "%ROOT%\com.windwings.motionhub\CSXS\manifest.xml" >nul 2>&1 && (
+        echo 注意：3.8 起 Studio 单独安装，这个安装包里没有 Studio。装完后「窗口 - 扩展」里暂时没有 MotionHub Studio，
+        echo 要用 Studio 就再运行 Studio 安装包里的「安装-Windows.bat」。按任意键继续安装面板…
+        pause >nul
+    )
+)
+rem 回退：要装的面板包是 3.7 及以前（自带 Studio）：先移除单独安装的 Studio
+findstr /r /c:"%OLDSTUDIO%" "%HERE%com.windwings.motionhub\CSXS\manifest.xml" >nul 2>&1 && (
+    if exist "%HERE%com.windwings.studio" (
+        echo 安装包里的文件夹版本对不上：这个 MotionHub 自带 Studio，不能和单独的 Studio 一起装。换用完整的安装包。
+        pause
+        exit /b 1
+    )
+    if exist "%ROOT%\com.windwings.studio" (
+        echo 回退到旧版 MotionHub：先移除单独安装的 Studio（它的设置文件 MotionHub\studio.json 保留）
+        rmdir /s /q "%ROOT%\com.windwings.studio"
+    )
+)
+
+tasklist /FI "IMAGENAME eq AfterFX.exe" 2>nul | find /I "AfterFX.exe" >nul
+if not errorlevel 1 (
+    echo 注意：After Effects 正在运行。请先完全关闭 AE，然后按任意键继续安装。
+    pause >nul
+)
+
+for %%i in (%IDS%) do (
+    if exist "%ROOT%\%%i" rmdir /s /q "%ROOT%\%%i"
+    xcopy "%HERE%%%i" "%ROOT%\%%i\" /E /I /Y /Q >nul
+    echo 已安装 %%i 到：%ROOT%\%%i
+    if exist "%SYSROOT%\%%i" echo 注意：系统目录里还有一份旧版，请手动删除：%SYSROOT%\%%i
+)
+rem 不再清 CEP 缓存：页面资源带 ?v=版本号，不会用到旧文件；缓存里还存着没写进磁盘的布局和 Studio 旧设置，清掉会丢
+
+rem 允许加载未签名扩展（AE 2020 及以上对应 CSXS 9-13）
+for %%v in (9 10 11 12 13) do reg add "HKCU\Software\Adobe\CSXS.%%v" /v PlayerDebugMode /t REG_SZ /d 1 /f >nul
+
+echo.
+echo 已开启扩展加载权限
+echo.
+echo 下一步：完全关闭 After Effects 后重新打开。
+echo %IDS% | find "motionhub" >nul && echo   面板：窗口 - 扩展 - MotionHub（以及 2 / 3 / 4）
+echo %IDS% | find "studio" >nul && echo   Studio：窗口 - 扩展 - MotionHub Studio · 剪辑排版，看左上角的版本号确认装的是新版
+echo.
+pause
