@@ -0,0 +1,21 @@
+// 两个扩展包共用的文件：com.windwings.motionhub 里的是原件，com.windwings.studio 里的是复制件，必须逐字节一样
+// 用法：node shared.js           检查：不一样就失败并列出文件
+//      node shared.js --write   把原件复制到 Studio 包（复制件自己有没提交的改动时拒绝，免得冲掉）
+"use strict";
+const fs = require("fs"), path = require("path"), crypto = require("crypto"), cp = require("child_process");
+const SRC = path.join(__dirname, "../com.windwings.motionhub"), DST = path.join(__dirname, "../com.windwings.studio");
+const FILES = ["css/style.css", "js/bridge.js", "js/icons.js", "fonts/OFL.txt",
+    "fonts/Geist-Regular.woff2", "fonts/Geist-Medium.woff2", "fonts/GeistMono-Regular.woff2", "fonts/GeistMono-Medium.woff2"];
+const write = process.argv.includes("--write");
+const sha = p => fs.existsSync(p) ? crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex").slice(0, 12) : "（没有）";
+const dirty = p => { try { cp.execFileSync("git", ["diff", "--quiet", "--", p], { cwd: __dirname }); return false; } catch (e) { return e.status === 1; } };
+let bad = 0;
+for (const f of FILES) {
+    const a = path.join(SRC, f), b = path.join(DST, f), ha = sha(a), hb = sha(b);
+    if (ha === hb) continue;
+    if (write && !dirty(b)) { fs.mkdirSync(path.dirname(b), { recursive: true }); fs.copyFileSync(a, b); console.log("已复制 " + f); continue; }
+    bad++;
+    console.log("✗ " + f + "：面板包 " + ha + " · Studio 包 " + hb + (write ? "（Studio 包里这份有没提交的改动，先把改动挪到面板包那份）" : ""));
+}
+console.log(bad ? "✗ 共用文件不一致：只改 com.windwings.motionhub 里的那份，再运行 node tests/shared.js --write" : "✓ 共用文件一致（" + FILES.length + " 个）");
+process.exit(bad ? 1 : 0);
