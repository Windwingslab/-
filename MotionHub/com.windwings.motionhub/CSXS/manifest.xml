<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.windwings.motionhub" ExtensionBundleVersion="3.2.0"
    ExtensionBundleName="MotionHub" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.windwings.motionhub.panel1" Version="3.2.0" />
        <Extension Id="com.windwings.motionhub.panel2" Version="3.2.0" />
        <Extension Id="com.windwings.motionhub.panel3" Version="3.2.0" />
        <Extension Id="com.windwings.motionhub.panel4" Version="3.2.0" />
        <Extension Id="com.windwings.motionhub.studio" Version="3.2.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2022 (22.0) 及以上：内置 Chromium 88 -->
            <Host Name="AEFT" Version="[22.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <!-- 4 个独立面板：窗口 → 扩展 → MotionHub / MotionHub 2 / 3 / 4，各自保存布局 -->
    <DispatchInfoList>
        <Extension Id="com.windwings.motionhub.panel1">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 节拍分析需要在面板里读取本地音频文件 -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub</Menu>
                    <Geometry>
                        <Size><Height>720</Height><Width>300</Width></Size>
                        <MinSize><Height>200</Height><Width>180</Width></MinSize>
                        <MaxSize><Height>3000</Height><Width>1600</Width></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
        <Extension Id="com.windwings.motionhub.panel2">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 节拍分析需要在面板里读取本地音频文件 -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub 2</Menu>
                    <Geometry>
                        <Size><Height>720</Height><Width>300</Width></Size>
                        <MinSize><Height>200</Height><Width>180</Width></MinSize>
                        <MaxSize><Height>3000</Height><Width>1600</Width></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
        <Extension Id="com.windwings.motionhub.panel3">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 节拍分析需要在面板里读取本地音频文件 -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub 3</Menu>
                    <Geometry>
                        <Size><Height>720</Height><Width>300</Width></Size>
                        <MinSize><Height>200</Height><Width>180</Width></MinSize>
                        <MaxSize><Height>3000</Height><Width>1600</Width></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
        <Extension Id="com.windwings.motionhub.panel4">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 节拍分析需要在面板里读取本地音频文件 -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub 4</Menu>
                    <Geometry>
                        <Size><Height>720</Height><Width>300</Width></Size>
                        <MinSize><Height>200</Height><Width>180</Width></MinSize>
                        <MaxSize><Height>3000</Height><Width>1600</Width></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
        <!-- Studio：剪辑排版大窗口 -->
        <Extension Id="com.windwings.motionhub.studio">
            <DispatchInfo>
                <Resources>
                    <MainPath>./studio.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 读写本地视频、帧序列和导出文件 -->
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--autoplay-policy=no-user-gesture-required</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub Studio · 剪辑排版</Menu>
                    <Geometry>
                        <Size><Height>780</Height><Width>1180</Width></Size>
                        <MinSize><Height>520</Height><Width>860</Width></MinSize>
                        <MaxSize><Height>3000</Height><Width>4000</Width></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
