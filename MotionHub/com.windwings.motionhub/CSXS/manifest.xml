<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.windwings.motionhub" ExtensionBundleVersion="2.0.0"
    ExtensionBundleName="MotionHub" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.windwings.motionhub.panel" Version="2.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2020 (17.0) 及以上 -->
            <Host Name="AEFT" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.windwings.motionhub.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MotionHub</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>200</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>3000</Height>
                            <Width>1600</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
